# This file is documentation only. Runtime secrets belong in the provider's
# secret/environment-variable manager, never in Git.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
APP_KEY=base64:generate-with-php-artisan-key-generate
CORS_ALLOWED_ORIGINS=https://www.example.com
SANCTUM_STATEFUL_DOMAINS=www.example.com
DB_CONNECTION=pgsql
DB_HOST=managed-postgres-host
DB_PORT=5432
DB_DATABASE=elastomeros
DB_USERNAME=managed-postgres-user
DB_PASSWORD=managed-postgres-password
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
FILESYSTEM_DISK=s3
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mailer-user
MAIL_PASSWORD=mailer-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notificaciones@example.com
MAIL_FROM_NAME="Elastómeros La Roca"
SALES_NOTIFICATION_EMAIL=comercial@example.com
AWS_ACCESS_KEY_ID=storage-access-key
AWS_SECRET_ACCESS_KEY=storage-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=private-uploads
VITE_API_URL=https://api.example.com/api
